[
  {
    "corsRuleName": "allow-app-uploads-downloads",
    "allowedOrigins": [
      "http://localhost:3000",
      "http://clg-pass-it-on.vercel.app"
    ],
    "allowedOperations": [
      "s3_put",
      "s3_get",
      "s3_head"
    ],
    "allowedHeaders": [
      "*"
    ],
    "exposeHeaders": [
      "ETag"
    ],
    "maxAgeSeconds": 3600
  }
]